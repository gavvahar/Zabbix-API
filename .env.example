ZABBIX_URL = "https://your-zabbix-server/api_jsonrpc.php"
ZABBIX_API_TOKEN = "your-zabbix-api-token"

# Optional — only needed by Python/Meraki/provision.py's `rollout`/`test` actions
ZABBIX_ORG_HOST = "your-org-level-meraki-host"
ZABBIX_TEST_HOST = "a-host-with-the-clone-template-attached"

# Optional — Meraki organization id. Without it, every clone/recreate ships
# with a CHANGE_IF_NEEDED placeholder for {$MERAKI.ORG.ID} that must be set
# by hand in Zabbix before Network/SSID/Radio Discovery will work.
MERAKI_ORG_ID = "your-meraki-organization-id"

# Optional — only needed by Meraki/provision.py's `resolve-networks` action.
# A Meraki Dashboard API key (Organization > Settings > Dashboard API
# access), distinct from Zabbix's own {$MERAKI.TOKEN} template macro -- this
# one is used to call the Meraki API directly, outside Zabbix.
MERAKI_API_TOKEN = "your-meraki-dashboard-api-key"
